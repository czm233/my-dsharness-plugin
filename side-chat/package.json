{
  "name": "@local/side-chat",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "侧边对话：打开 tab 即把当前会话原生分叉成真会话——官方完整输入区、状态栏与继承的历史从一开始就全部呈现，在右栏继续聊。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
