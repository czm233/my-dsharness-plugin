{
  "name": "@local/side-chat",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "侧边对话：在官方右栏为当前会话开一个 fork 型子代理分支——首条消息前先只读预览主对话最近几轮（可划词「引用」进侧栏输入框），发送后完整继承父会话已完成轮次并继续聊；不进左侧列表，关闭 tab 不影响子会话，可从父会话头部子代理目录找回。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
