{
  "name": "@local/side-chat",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "侧边对话：在官方右栏为当前会话开一个分支（fork 出真实会话、名字加后缀），在右栏 tab 里用完整对话界面继续聊；分支即建即归档，不出现在左侧列表，避免误操作；关闭 tab 时可选「保留」（取消归档回列表）或「不保留」（保持归档）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
