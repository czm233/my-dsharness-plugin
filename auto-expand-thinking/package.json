{
  "name": "@local/auto-expand-thinking",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Auto-expands reasoning (thinking) rows while the reply is in progress and folds them back closed once the reply finishes; re-arms on the next turn.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
