{
  "name": "@local/business-flows",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "业务流程：按工程收藏的 Markdown 笔记——回复尾部一键收藏问答原文，tab 左列表右阅读，正文可编辑、追加、粘贴截图。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
