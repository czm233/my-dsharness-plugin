{
  "name": "@local/dsh-full-access-default",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Makes every newly created session start with the configured default permission preset (danger-full-access by default) instead of the composed deployment default.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-permission-presets"
      ]
    }
  }
}
